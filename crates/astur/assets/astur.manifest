<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded by build.rs into astur.exe and astur-settings.exe. Declares the
     normal (asInvoker) privilege level and the supported Windows versions.
     No dpiAwareness here on purpose: both exes set it at runtime, and a
     manifest value would make that call fail. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
